APP_ENV=production
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=api_test_platform
MYSQL_USER=api_user
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_PORT=3306
WEB_PORT=5000
TZ=Asia/Shanghai

# Docker Compose 默认根据上面的 MYSQL_* 变量生成数据库连接。
# 只有连接外部数据库时才取消下一行注释；密码中的特殊字符需要 URL 编码。
# DATABASE_URL=mysql+pymysql://api_user:password@mysql:3306/api_test_platform?charset=utf8mb4

MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

BASE_REPORT_URL=http://localhost:5000
SCHEDULER_TIMEZONE=Asia/Shanghai
ENABLE_SCHEDULER=true

GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
